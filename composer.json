{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "data-health/data-health-mcp",
    "description": "Explain, inspect, verify, and resolve Data Health findings through MCP",
    "keywords": [
        "laravel",
        "data-health",
        "mcp"
    ],
    "homepage": "https://github.com/data-health-php/data-health-mcp",
    "license": "MIT",
    "authors": [
        {
            "name": "Jascha Gerles",
            "email": "jascha.gerles@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "data-health/data-health": "^0.1.1",
        "laravel/mcp": "^1.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "DataHealth\\Mcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DataHealth\\Mcp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "DataHealth\\Mcp\\DataHealthMcpServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../data-health",
            "options": {
                "symlink": true,
                "versions": {
                    "data-health/data-health": "0.1.1"
                }
            }
        }
    ],
    "support": {
        "issues": "https://github.com/data-health-php/data-health-mcp/issues",
        "source": "https://github.com/data-health-php/data-health-mcp"
    }
}
